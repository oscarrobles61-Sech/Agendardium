{
  "name": "agendardium",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.mjs",
    "db:migrate:new": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:import": "node scripts/import.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "prisma": "^7.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
