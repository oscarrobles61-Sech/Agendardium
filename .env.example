# Cadena de conexión de Neon (Dashboard → Connect → elegí "Pooled connection")
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Conexión directa de Neon (sin "-pooler"), usada por Prisma para migrar. Opcional.
DATABASE_URL_UNPOOLED=postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Opcional: claves VAPID para los avisos push. Si no están, la app las genera y las guarda en la base.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:secretaria@ejemplo.com
